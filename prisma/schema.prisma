// Schéma Prisma — App de planification de repas (usage familial, 6 personnes)
// Voir PLAN-DEV-CLAUDE-CODE.md §2

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Multi-foyers (Phase 0) : Household = le "locataire", User = les membres.
// ---------------------------------------------------------------------------
model Household {
  id                 String   @id @default(cuid())
  name               String   @default("Mon foyer")
  plan               Plan     @default(FREE) // abonnement (Stripe branché en Phase 2)
  stripeCustomerId   String?
  subscriptionStatus String?
  onboardedAt        DateTime? // null tant que l'onboarding n'est pas terminé
  inviteCode         String?  @unique // code de partage du foyer (inviter un membre)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users          User[]
  recipes        Recipe[]
  plannedMeals   PlannedMeal[]
  shoppingExtras ShoppingExtra[]
  shoppingChecks ShoppingListCheck[]
  pushSubs       PushSub[]
  settings       Settings?
}

// Compte utilisateur. id = identifiant Supabase Auth (rempli en Phase 0.1).
model User {
  id          String    @id
  email       String    @unique
  householdId String
  household   Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        String     @default("member") // owner | member
  createdAt   DateTime   @default(now())

  @@index([householdId])
}

model Recipe {
  id             String        @id @default(cuid())
  householdId    String
  household      Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name           String
  category       Category
  prepTime       String // ex: "30 min" (texte libre, affichage seulement)
  containsStarch Boolean       @default(false) // féculent -> réservé au déjeuner
  starchFamily   StarchFamily? // règle anti-répétition
  season         Season        @default(ALL) // ALL | ETE | HIVER | HIVER_PREF
  mealTime       MealTime      @default(BOTH) // MIDI | SOIR | BOTH
  dayType        DayType       @default(BOTH) // SEMAINE | WEEKEND | BOTH
  minGapDays     Int           @default(14) // espacement minimum avant réapparition
  servingsBase   Int           @default(6)
  isFavorite     Boolean       @default(false) // ★ favori, choisi par l'utilisateur (jamais par l'IA)
  steps          String[] // une étape par élément
  ingredients    Ingredient[]
  plannedMeals   PlannedMeal[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([householdId])
}

model Ingredient {
  id            String   @id @default(cuid())
  recipeId      String
  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name          String // nom normalisé, ex: "oignon", "blanc de poulet"
  quantity      Float? // nullable si "au goût" / "sel, poivre"
  unit          Unit? // g, kg, ml, cl, l, piece, cas, cac, pincee...
  note          String? // précision libre, ex: "au goût", "émincé"
  aisle         Aisle // rayon pour la liste de courses
  raw           String? // ligne d'origine du seed, pour relecture
  isChoice      Boolean  @default(false) // "garniture au choix" -> choisie au moment de planifier
  choiceOptions String[] // options possibles si isChoice (ex: jambon, champignons...)

  @@index([recipeId])
}

model PlannedMeal {
  id       String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  mealTime MealTime // MIDI | SOIR (pas BOTH ici)
  recipeId String?
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  servings Int      @default(6)
  choices  Json? // { [ingredientId]: "option choisie" } pour les garnitures au choix
  remindedAt DateTime? // rappel "à vos fourneaux" déjà envoyé pour ce repas
  preparedAt DateTime? // repas cuisiné à l'avance (batch cooking) -> juste à réchauffer
  storage    String? // "frigo" | "congelo" : où le plat préparé est conservé

  @@unique([householdId, date, mealTime])
  @@index([date])
  @@index([householdId])
}

// Abonnements Web Push (un par appareil/navigateur).
model PushSub {
  id        String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([householdId])
}

// Articles ajoutés à la main sur la liste de courses (piles, gel douche…).
model ShoppingExtra {
  id         String   @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rangeStart DateTime @db.Date
  rangeEnd   DateTime @db.Date
  name       String
  checked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([rangeStart, rangeEnd])
  @@index([householdId])
}

// Réglages d'un foyer (une ligne par Household).
model Settings {
  id          String   @id @default(cuid())
  householdId String   @unique
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  servings    Int      @default(6) // nombre de personnes par défaut
  allergies   String[] // ingrédients allergènes -> jamais planifiés
  forbidden   String[] // aliments interdits -> jamais planifiés
  bgColor     String? // couleur de fond personnalisée (hex)
  cardColor   String? // couleur des cartes / vignettes (hex)
  accentColor String? // couleur d'accent (hex)
  // Heures des repas (pour les rappels de cuisine)
  lunchTime     String  @default("12:30")
  lunchEnabled  Boolean @default(false)
  dinnerTime    String  @default("19:30")
  dinnerEnabled Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

model ShoppingListCheck {
  id            String   @id @default(cuid())
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rangeStart    DateTime @db.Date
  rangeEnd      DateTime @db.Date
  ingredientKey String // nom normalisé + unité, sert de clé stable
  checked       Boolean  @default(false)

  @@unique([householdId, rangeStart, rangeEnd, ingredientKey])
  @@index([householdId])
}

enum Plan {
  FREE
  PREMIUM
}

enum Category {
  FAVORI
  RAPIDE
  HEALTHY
  SALADE_ETE
  SOUPE_HIVER
}

enum MealTime {
  MIDI
  SOIR
  BOTH
}

enum DayType {
  SEMAINE
  WEEKEND
  BOTH
}

enum Season {
  ALL
  ETE
  HIVER
  HIVER_PREF
}

enum StarchFamily {
  PATES
  RIZ
  PDT
  PAIN
  PIZZA
  TORTILLA
  SEMOULE
  QUINOA
  GALETTE
  PATE_BRISEE // présent dans le seed (quiche/tarte), absent du cahier des charges initial
}

enum Unit {
  G
  KG
  ML
  CL
  L
  PIECE
  CAS
  CAC
  PINCEE
}

enum Aisle {
  BOUCHERIE
  POISSONNERIE
  CREMERIE
  FRUITS_LEGUMES
  EPICERIE
  AUTRES
}
