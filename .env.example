# ---------------------------------------------------------------------------
# Base de données Supabase (Postgres)
# Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL : connexion POOLÉE (Transaction pooler, port 6543). Utilisée par
#   l'app en runtime (serverless Vercel). Ajouter ?pgbouncer=true&connection_limit=1
# DIRECT_URL   : connexion DIRECTE (port 5432). Utilisée par Prisma pour les
#   migrations et le seed (le pooler ne supporte pas les prepared statements).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Protection d'accès (middleware) — mot de passe partagé du foyer
# ---------------------------------------------------------------------------
APP_PASSWORD="choisir-un-mot-de-passe"
# Secret pour signer le cookie de session (générer: openssl rand -hex 32)
AUTH_SECRET="remplacer-par-une-valeur-aleatoire-longue"

# ---------------------------------------------------------------------------
# IA (Claude / Anthropic) — pour la génération de recettes
# console.anthropic.com → API Keys → Create Key
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# SEO / vitrine
#
# NEXT_PUBLIC_SITE_URL : origine canonique du site (sans slash final). Sert au
#   metadataBase, aux URLs canoniques, au sitemap et au robots.txt.
#   En l'absence de valeur : VERCEL_PROJECT_PRODUCTION_URL, sinon localhost.
# NEXT_PUBLIC_SEO_INDEX : "true" ouvre la vitrine à l'indexation Google.
#   NE PAS mettre "true" avant le lancement public (nom + domaine + légal prêts).
#   Tant que ce n'est pas "true", tout le site est en noindex + robots Disallow.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://chillmeals.fr"
NEXT_PUBLIC_SEO_INDEX="false"

# ---------------------------------------------------------------------------
# Mesure d'audience — Google Tag Manager (GA4 configuré DANS GTM)
#
# NEXT_PUBLIC_GTM_ID : identifiant du conteneur GTM (format "GTM-XXXXXXX").
#   TANT QUE VIDE : aucun script GTM chargé, aucun bandeau cookies, aucun cookie.
#   Une fois renseigné : Consent Mode v2 "denied" par défaut + bandeau de
#   consentement (accepter / refuser) ; la mesure ne démarre qu'après acceptation.
#   ⚠️ NEXT_PUBLIC_* lu au build -> redeploy nécessaire.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID="GTM-5MW8CHQ9"

# Connexion Google : "true" affiche le bouton « Continuer avec Google »
# (nécessite le provider Google activé dans Supabase). Lu au build.
NEXT_PUBLIC_GOOGLE_AUTH="true"
